# Example only. On Streamlit Community Cloud, paste the filled-in version into
# your app's Settings > Secrets box. Locally you can use .env instead.
# Never commit a real .streamlit/secrets.toml (git ignores it).

APP_PASSWORD = "pick-a-long-password"

# Optional: read receipts with Claude. Leave out to use the stub.
ANTHROPIC_API_KEY = "sk-ant-..."
TALLYABLE_MODEL = "claude-sonnet-5-5"

# Optional: push to Google Sheets. Copy each field from service_account.json.
TALLYABLE_SHEET_ID = "the-long-id-from-the-sheet-url"

[gcp_service_account]
type = "service_account"
project_id = "tallyable-123456"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "tallyable-bot@tallyable-123456.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
