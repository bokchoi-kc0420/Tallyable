# Copy this file to .env and paste your key after the =. Never commit .env.
ANTHROPIC_API_KEY=
# Optional. claude-haiku-5-5 is cheapest, claude-opus-5-5 is the most capable.
TALLYABLE_MODEL=claude-sonnet-5-5
# Optional, for pushing to Google Sheets (see docs/google_sheets_setup.md).
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
TALLYABLE_SHEET_ID=
